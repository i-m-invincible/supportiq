# Copy to .env at repository root. No API key is needed for the default demo.
# Local development uses SQLite when DATABASE_URL is omitted.
# DATABASE_URL=sqlite:///./supportiq.db
AUTO_CREATE_SCHEMA=true
SEED_DEMO=true
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLASSIFICATION_THRESHOLD=0.45
RETRIEVAL_THRESHOLD=0.09

# Optional hosted LLM. Set all three to enable. API billing is separate from ChatGPT.
# Choose a Responses-compatible model available to your API project.
DRAFT_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_TIMEOUT_SECONDS=20

# Local Docker demo only. Set a strong alphanumeric password before deployment.
POSTGRES_PASSWORD=supportiq_local_demo
